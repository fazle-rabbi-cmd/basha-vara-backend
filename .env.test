# Test Environment Variables
NODE_ENV=test

# Database
DATABASE_URL=postgresql://basha_vara_user:local_dev_password_change_me@localhost:5433/basha_vara_test?schema=public
DIRECT_URL=postgresql://basha_vara_user:local_dev_password_change_me@localhost:5433/basha_vara_test?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=test_jwt_secret_for_testing_only
JWT_REFRESH_SECRET=test_refresh_secret_for_testing_only
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Email
EMAIL_FROM=test@example.com
BREVO_API_KEY=test_brevo_key
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASS=test
SMTP_SECURE=false

# Firebase (test credentials)
FIREBASE_PROJECT_ID=test-project
FIREBASE_PRIVATE_KEY=test-private-key
FIREBASE_CLIENT_EMAIL=test@example.com

# Google OAuth (test credentials)
GOOGLE_CLIENT_ID=test_google_client_id
GOOGLE_CLIENT_SECRET=test_google_client_secret
GOOGLE_NATIVE_REDIRECT_URI=http://localhost:3000/auth/native-google/callback

# Frontend
FRONTEND_URL=http://localhost:3000

# Upload
UPLOAD_DIR=./uploads/test
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=error
