generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                @id @default(uuid()) @db.Uuid
  email             String                @unique
  phone             String?
  passwordHash      String?
  fullName          String
  avatarUrl         String?
  status            UserStatus            @default(ACTIVE)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  authActionTokens  AuthActionToken[]
  favourites        Favourite[]           @relation("TenantFavourites")
  landlordProfile   LandlordProfile?
  properties        Property[]            @relation("LandlordProperties")
  applicationsMade  RentalApplication[]   @relation("TenantApplications")
  tenantProfile     TenantProfile?
  roles             UserRole[]
  visitRequestsMade VisitRequest[]        @relation("TenantVisits")
  notifications     Notification[]
  applicationProfile ApplicationProfile?

  @@map("users")
}

model AuthActionToken {
  id        String                 @id @default(uuid()) @db.Uuid
  userId    String                 @db.Uuid
  tokenHash String                 @unique
  purpose   AuthActionTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime               @default(now())
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, usedAt])
  @@index([expiresAt])
  @@map("auth_action_tokens")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  description     String?
  category        String
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model TenantProfile {
  id                     String         @id @default(uuid()) @db.Uuid
  userId                 String         @unique @db.Uuid
  occupation             String?
  moveInDatePreference   DateTime?
  householdSize          Int?
  preferredLocations     String[]       @default([])
  budgetMin              Decimal?       @db.Decimal(12, 2)
  budgetMax              Decimal?       @db.Decimal(12, 2)
  preferredPropertyTypes PropertyType[] @default([])
  bio                    String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tenant_profiles")
}

model LandlordProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  businessName      String?
  contactPreference String?
  bio               String?
  verified          Boolean  @default(false)
  responseRate      Int      @default(100)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("landlord_profiles")
}

model Property {
  id             String              @id @default(uuid()) @db.Uuid
  landlordId     String              @db.Uuid
  title          String
  description    String
  propertyType   PropertyType
  rentAmount     Decimal             @db.Decimal(12, 2)
  depositAmount  Decimal?            @db.Decimal(12, 2)
  bedrooms       Int
  bathrooms      Int
  areaSqft       Int?
  floor          Int?
  totalFloors    Int?
  addressLine    String
  area           String
  city           String              @default("Dhaka")
  district       String              @default("Dhaka")
  availableFrom  DateTime
  status         PropertyStatus      @default(DRAFT)
  viewCount      Int                 @default(0)
  favouriteCount Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  lat            Float?
  lng            Float?
  favourites     Favourite[]
  landlord       User                @relation("LandlordProperties", fields: [landlordId], references: [id])
  amenities      PropertyAmenity[]
  photos         PropertyPhoto[]
  applications   RentalApplication[]
  visits         VisitRequest[]

  @@index([landlordId])
  @@index([status])
  @@index([area])
  @@index([propertyType])
  @@index([rentAmount])
  @@map("properties")
}

model PropertyPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  url        String
  storageKey String?
  caption    String?
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_photos")
}

model Amenity {
  id         String            @id @default(uuid()) @db.Uuid
  name       String            @unique
  slug       String            @unique
  icon       String?
  category   AmenityCategory   @default(ESSENTIAL)
  properties PropertyAmenity[]

  @@map("amenities")
}

model PropertyAmenity {
  propertyId String   @db.Uuid
  amenityId  String   @db.Uuid
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@index([propertyId])
  @@index([amenityId])
  @@map("property_amenities")
}

model Favourite {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  propertyId String   @db.Uuid
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant     User     @relation("TenantFavourites", fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, propertyId])
  @@index([tenantId])
  @@index([propertyId])
  @@map("favourites")
}

model VisitRequest {
  id            String      @id @default(uuid()) @db.Uuid
  propertyId    String      @db.Uuid
  tenantId      String      @db.Uuid
  requestedDate DateTime
  requestedTime String
  message       String?
  visitType     VisitType   @default(IN_PERSON)
  guestCount    Int         @default(1)
  contactPhone  String?
  status        VisitStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  property      Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant        User        @relation("TenantVisits", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([tenantId])
  @@index([status])
  @@map("visit_requests")
}

model RentalApplication {
  id           String            @id @default(uuid()) @db.Uuid
  propertyId   String            @db.Uuid
  tenantId     String            @db.Uuid
  coverNote    String?
  moveInDate   DateTime?
  proposedRent Decimal?          @db.Decimal(12, 2)
  status       ApplicationStatus @default(SUBMITTED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  property     Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant       User              @relation("TenantApplications", fields: [tenantId], references: [id], onDelete: Cascade)
  documents    ApplicationDocument[]

  @@index([propertyId])
  @@index([tenantId])
  @@index([status])
  @@map("rental_applications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  action     String
  resource   String
  resourceId String?
  details    Json?
  success    Boolean
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean             @default(false)
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  displayName String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles        UserRole[]
  rolePermissions  RolePermission[]

  @@map("roles")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum PropertyType {
  APARTMENT
  FLAT
  HOUSE
  STUDIO
  ROOM
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  PAUSED
  RENTED
  ARCHIVED
}

enum VisitStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}

enum VisitType {
  IN_PERSON
  VIDEO_CALL
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  WITHDRAWN
  SELECTED
}

enum AmenityCategory {
  ESSENTIAL
  LUXURY
  SAFETY
  UTILITY
}

enum AuthActionTokenPurpose {
  PASSWORD_SETUP
  PASSWORD_RESET
}

enum SystemPermission {
  PROPERTY_CREATE
  PROPERTY_READ_OWN
  PROPERTY_READ_ANY
  PROPERTY_UPDATE_OWN
  PROPERTY_UPDATE_ANY
  PROPERTY_DELETE_OWN
  PROPERTY_DELETE_ANY
  PROPERTY_CHANGE_STATUS_OWN
  PROPERTY_CHANGE_STATUS_ANY
  VISIT_CREATE
  VISIT_READ_OWN
  VISIT_READ_ANY
  VISIT_UPDATE_OWN
  VISIT_UPDATE_ANY
  VISIT_DELETE_OWN
  VISIT_DELETE_ANY
  APPLICATION_CREATE
  APPLICATION_READ_OWN
  APPLICATION_READ_ANY
  APPLICATION_UPDATE_OWN
  APPLICATION_UPDATE_ANY
  APPLICATION_DELETE_OWN
  APPLICATION_DELETE_ANY
  APPLICATION_STATUS_UPDATE_OWN
  APPLICATION_STATUS_UPDATE_ANY
  USER_READ_OWN
  USER_READ_ANY
  USER_UPDATE_OWN
  USER_UPDATE_ANY
  USER_DELETE_OWN
  USER_DELETE_ANY
  USER_ASSIGN_ROLE
  ADMIN_VIEW_METRICS
  ADMIN_MODERATE_PROPERTIES
  ADMIN_MODERATE_USERS
  ADMIN_MANAGE_ROLES
}

enum NotificationType {
  VISIT_REQUESTED
  VISIT_ACCEPTED
  VISIT_DECLINED
  VISIT_CANCELLED
  VISIT_COMPLETED
  APPLICATION_SUBMITTED
  APPLICATION_UNDER_REVIEW
  APPLICATION_SHORTLISTED
  APPLICATION_REJECTED
  APPLICATION_SELECTED
  APPLICATION_WITHDRAWN
  PROPERTY_PUBLISHED
  PROPERTY_RENTED
  PROPERTY_PAUSED
  SYSTEM
}

model ApplicationProfile {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @unique @db.Uuid
  fullName          String
  phone             String
  email             String
  employmentStatus  String
  monthlyIncome     Decimal?      @db.Decimal(12, 2)
  hasPets           Boolean       @default(false)
  petDetails        String?
  emergencyContact  String?
  emergencyPhone    String?
  references        Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("application_profiles")
}

model ApplicationDocument {
  id              String   @id @default(uuid()) @db.Uuid
  applicationId   String   @db.Uuid
  documentType    String
  fileName        String
  fileUrl         String
  fileSize        Int
  mimeType        String
  uploadedAt      DateTime @default(now())
  application     RentalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_documents")
}
