# Server configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# WebSocket Configuration
FRONTEND_URL=http://localhost:3000

# Prisma Studio (set to false to prevent STUDIO_EMBED_BUILD errors)
STUDIO_EMBED_BUILD=false

# PostgreSQL Database (Docker Compose)
DATABASE_URL="postgresql://basha_vara_user:local_dev_password_change_me@localhost:5433/basha_vara?schema=public"

# For production (Supabase/Render/Railway), add connection pool parameters:
# DATABASE_URL="postgresql://user:password@host:port/database?schema=public&connection_limit=5&pool_timeout=10"
# DIRECT_URL="postgresql://user:password@host:5432/database?schema=public"

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="dev_jwt_access_secret_basha_vara_2026_super_secure_key"
JWT_REFRESH_SECRET="dev_jwt_refresh_secret_basha_vara_2026_super_secure_key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_NATIVE_REDIRECT_URI=https://your-backend.onrender.com/api/v1/auth/google/native/callback
NATIVE_APP_REDIRECT_URI=bashavara://auth/callback

# Supabase Storage (Free tier: 1GB storage, 2GB bandwidth/month)
# Create a project at https://supabase.com, then create a storage bucket named "basha-vara-uploads"
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Firebase Cloud Messaging (FCM) - Completely free for push notifications
# Create a project at https://console.firebase.google.com
# 1. Create a new Firebase project
# 2. Go to Project Settings → General → Your apps → Add Web app
# 3. Copy the firebaseConfig values below
# 4. Go to Project Settings → Service accounts → Generate new private key
# 5. Save the JSON file as backend/firebase-service-account.json (NOT in .env)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# Auth email queue and email delivery
# All background jobs run on pg-boss (PostgreSQL-native, no Redis needed)
EMAIL_WORKER_ENABLED=false
# Brevo HTTPS API for Render Free
BREVO_API_KEY=
EMAIL_FROM=Basha Vara <your-verified-sender@example.com>
# SMTP fallback for local development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-gmail-app-password
FRONTEND_URL=http://localhost:3000

# Super Admin bootstrap (one-time operation to create first super admin - REQUIRED!)
# Set SUPER_ADMIN_BOOTSTRAP_CONFIRM=CREATE_PRODUCTION_SUPER_ADMIN to proceed
SUPER_ADMIN_BOOTSTRAP_CONFIRM=
SUPER_ADMIN_BOOTSTRAP_EMAIL=
SUPER_ADMIN_BOOTSTRAP_PASSWORD=
SUPER_ADMIN_BOOTSTRAP_NAME=

# Notification emails (optional - in-app notifications work without this)
# Set to true to enable email notifications for visits and applications
ENABLE_NOTIFICATION_EMAILS=false
