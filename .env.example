# Server configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database (Docker Compose)
DATABASE_URL="postgresql://basha_vara_user:local_dev_password_change_me@localhost:5433/basha_vara?schema=public"

# For production (Supabase/Render/Railway), add connection pool parameters:
# DATABASE_URL="postgresql://user:password@host:port/database?schema=public&connection_limit=5&pool_timeout=10"

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="dev_jwt_access_secret_basha_vara_2026_super_secure_key"
JWT_REFRESH_SECRET="dev_jwt_refresh_secret_basha_vara_2026_super_secure_key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Auth email queue and SMTP delivery
REDIS_URL=redis://127.0.0.1:6379
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=Basha Vara <your-sender@gmail.com>
FRONTEND_URL=http://localhost:3000
